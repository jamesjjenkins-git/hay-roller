{
  "name": "farmyard-casino",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based, farm-themed play-money casino. First game: Hay Bale Derby.",
  "scripts": {
    "start": "npx --yes serve -l 8080 .",
    "test": "node --test \"tests/*.test.js\"",
    "shots": "node scripts/track-shots.js",
    "shots:setup": "npm install && npx playwright install chromium",
    "build:web": "node scripts/build-web.js",
    "ios": "node scripts/build-web.js && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "playwright": "1.56.1"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.1.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "farm-store": "file:plugins/farm-store"
  }
}
